{
  "name": "dopa-content-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "dopa-render": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "ci:fixture": "node scripts/create-ci-claude-zip.mjs work/ci-input.zip",
    "config:claude-desktop": "npm run build && node scripts/create-claude-desktop-config.mjs",
    "approval:dopa": "npm run build && node scripts/create-local-approval.mjs",
    "mcp:content-planner": "npm run build && node dist/src/mcp/stdio.js",
    "mcp:remote": "npm run build && node dist/src/mcp/http.js",
    "publish:meta-due": "npm run build && node dist/src/publishing/meta-worker.js",
    "proof:eye-animation": "node scripts/create-eye-animation-proof.mjs",
    "render:example": "npm run build && node dist/src/cli.js examples/static-design/manifest.json",
    "render:worker": "npm run build && node dist/src/worker/main.js",
    "test": "npm run build && node --test dist/test/**/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@resvg/resvg-js": "^2.6.2",
    "playwright": "^1.55.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22"
  }
}
