{
  "name": "dopa-content-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "dopa-render": "dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "ci:fixture": "node scripts/create-ci-claude-zip.mjs work/ci-input.zip",
    "approval:dopa": "npm run build && node scripts/create-local-approval.mjs",
    "proof:eye-animation": "node scripts/create-eye-animation-proof.mjs",
    "render:example": "npm run build && node dist/src/cli.js examples/static-design/manifest.json",
    "test": "npm run build && node --test dist/test/**/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "playwright": "^1.55.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22"
  }
}
